# fargate/run-task.sh가 읽는 환경 파일 — 계정별 값이라 저장소에 커밋하지 않는다.
# 사용법: cp env.example env → 값 채우기 → run-task.sh가 자동 로드 (fargate/env는 .gitignore 대상)

# ECS 클러스터 이름
LT_CLUSTER=newcodes-loadtest

# private 서브넷 (NAT Gateway 경유 → 고정 EIP, bypass 등록 대상). 콤마 구분, AZ 분산 시 EIP도 분산됨
LT_SUBNETS_PRIVATE=subnet-xxxxxxxx,subnet-yyyyyyyy

# public 서브넷 (--public 모드용: 임의 public IP → rate-limit-check 용)
LT_SUBNETS_PUBLIC=subnet-zzzzzzzz

# 보안 그룹 (아웃바운드 443/80 허용이면 충분)
LT_SG=sg-xxxxxxxx

# Prometheus remote-write 엔드포인트 (예: http://<서버IP>:9090/api/v1/write). 비우면 --out 미사용
LT_PROM_RW_URL=

# 부하테스트 대상
LT_BASE_URL=https://newcodes.net
