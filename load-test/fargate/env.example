# fargate/run-task.sh가 읽는 환경 파일 — 계정별 값이라 저장소에 커밋하지 않는다.
# 사용법: cp env.example env → 값 채우기 → run-task.sh가 자동 로드 (fargate/env는 .gitignore 대상)

# ECS 클러스터 이름
LT_CLUSTER=newcodes-loadtest

# k6 task용 public 서브넷 (콤마 구분). assignPublicIp=ENABLED로 매번 임의 public IP를 받음 —
# NAT Gateway 불필요(고정 IP 대신 X-LoadTest-Token 헤더로 bypass 판별, 아래 LT_BYPASS_TOKEN 참고)
LT_SUBNETS_PUBLIC=subnet-xxxxxxxx,subnet-yyyyyyyy

# 보안 그룹 (아웃바운드 443/80 허용이면 충분)
LT_SG=sg-xxxxxxxx

# nginx rate limit bypass 시크릿 — 운영 호스트의 nginx/loadtest_token.conf와 같은 값이어야 함
# (MOCK_SERVICE_SETUP.md 참고). -s rate-limit-check 또는 --no-bypass 시에는 주입되지 않음.
LT_BYPASS_TOKEN=

# Prometheus remote-write 엔드포인트 — nginx의 /loadtest-prom/ 프록시 경유(9090 직접 개방 안 함).
# https://newcodes.net/loadtest-prom/api/v1/write . 비우면 --out 미사용. LT_BYPASS_TOKEN이 있으면
# K6_PROMETHEUS_RW_HTTP_HEADERS로 자동으로 같이 실어 보낸다(run-task.sh).
LT_PROM_RW_URL=

# 부하테스트 대상
LT_BASE_URL=https://newcodes.net

# 상시 LLM mock ECS 서비스 (run-prod-test.sh 헬스체크용) — MOCK_SERVICE_SETUP.md 참고
# 클러스터가 LT_CLUSTER와 같으면 비워도 됨(LT_CLUSTER로 fallback)
LT_MOCK_CLUSTER=
LT_MOCK_SERVICE=llm-mock
