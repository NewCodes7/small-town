            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#73BF69" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/api/rag/answer\", method=\"POST\"}[$__rate_interval])))",
          "hide": false,
          "instant": false,
          "range": true,
          "legendFormat": "p50",
          "refId": "A"
