          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(http_server_requests_seconds_count{uri=\"/api/rag/answer\", method=\"POST\", outcome=\"SERVER_ERROR\"}[$__range]))",
          "instant": true,
          "range": false,
          "legendFormat": "5xx",
          "refId": "A"
        }
      ]
    },
