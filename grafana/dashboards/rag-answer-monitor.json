          "expr": "sum(increase(http_server_requests_seconds_count{uri=\"/api/rag/answer\", method=\"POST\", status=\"429\"}[$__range]))",
          "instant": true,
          "range": false,
          "legendFormat": "429",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 지연시간 (기간 내)",
      "description": "SSE 스트리밍 전체 소요시간(전처리+검색+LLM) p95",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 15 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/api/rag/answer\", method=\"POST\"}[$__range])))",
          "instant": true,
          "range": false,
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "요청 처리 지연시간 추이 (p50/p95/p99)",
      "description": "http_server_requests_seconds_bucket{uri=\"/api/rag/answer\"} 기반. SSE 응답이 완료(emitter.complete())되는 시점까지의 전체 요청 시간 — 전처리·하이브리드 검색·LLM 스트리밍을 모두 포함한다.",
