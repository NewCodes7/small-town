  "title": "Small Town — RAG Answer (/api/rag/answer)",
  "uid": "small-town-rag-answer",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "요청 수 (기간 내)",
      "description": "http_server_requests_seconds_count{uri=\"/api/rag/answer\"} 증가량 합",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(http_server_requests_seconds_count{uri=\"/api/rag/answer\", method=\"POST\"}[$__range]))",
          "instant": true,
          "range": false,
          "legendFormat": "요청 수",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "5xx 에러 수 (기간 내)",
      "description": "http_server_requests_seconds_count{uri=\"/api/rag/answer\", outcome=SERVER_ERROR} 증가량 합. 429(Rate limit)는 CLIENT_ERROR로 별도 집계되어 제외됨.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
