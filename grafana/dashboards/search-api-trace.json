          "show": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"$service\" && trace:rootName=\"$root\" && trace:duration > $slow_threshold}",
          "limit": 50,
          "tableType": "traces",
          "refId": "A"
