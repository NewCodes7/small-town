      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{trace:id=\"$traceId\" && span.db.system != \"\"} | select(name, span.db.sql.table, span.db.statement)",
          "limit": 1,
