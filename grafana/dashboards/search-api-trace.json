  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "① 검색 API 트레이스 고르기 — Trace Name/Service 셀을 클릭하면 아래 ②③ 패널이 그 트레이스로 채워집니다",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "table",
      "title": "최근 검색 API 트레이스 ($root)",
      "description": "루트 span이 $root 인 트레이스 = 검색 API 요청 1건 전체. Duration은 요청 전체 응답시간이고, 그 안에 BM25/Vector/NSF/JDBC span이 모두 자식으로 들어있다 (searchExecutor가 ContextExecutorService로 감싸져 있어 비동기 Vector 검색도 같은 trace에 붙는다). Trace Name 셀을 클릭하면 아래 워터폴·구간·SQL 패널이 해당 트레이스로 전환된다.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"$service\" && trace:rootName=\"$root\"}",
          "limit": 50,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceName"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "이 트레이스를 ②③ 패널에 로드",
                    "url": "/d/small-town-search-api/?var-traceId=${__data.fields.traceIdHidden}&${service:queryparam}&${root:queryparam}&from=${__from}&to=${__to}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traceService"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "이 트레이스를 ②③ 패널에 로드",
                    "url": "/d/small-town-search-api/?var-traceId=${__data.fields.traceIdHidden}&${service:queryparam}&${root:queryparam}&from=${__from}&to=${__to}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "느린 트레이스 (전체 응답 > $slow_threshold)",
      "description": "trace:duration 기준 — span 단위가 아니라 요청 전체 소요시간으로 거른다. 여기서 트레이스를 고른 뒤 ② 워터폴에서 어느 구간이 잡아먹었는지 확인하면 된다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
