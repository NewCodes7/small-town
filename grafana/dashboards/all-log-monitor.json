{
  "__requires": [
    { "type": "datasource", "id": "loki",       "name": "Loki",       "version": "1.0.0" },
    { "type": "panel",      "id": "logs",        "name": "Logs",       "version": "" },
    { "type": "panel",      "id": "stat",        "name": "Stat",       "version": "" },
    { "type": "panel",      "id": "timeseries",  "name": "Time series","version": "" },
    { "type": "panel",      "id": "bargauge",    "name": "Bar gauge",  "version": "" }
  ],

  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },

  "description": "전체 로그 레벨(ERROR·WARN·INFO·DEBUG) 모니터링 — small-town 앱 + 크롤러 (Loki)",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Error Log Monitor",
      "tooltip": "에러 로그 전용 대시보드",
      "type": "link",
      "url": "/d/small-town-error-logs"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 30,
  "style": "dark",
  "tags": ["loki", "logs", "small-town"],

  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values(instance)",
        "hide": 0,
        "includeAll": true,
        "label": "Instance",
        "multi": false,
        "name": "instance",
        "options": [],
        "query": "label_values(instance)",
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values(job)",
        "hide": 0,
        "includeAll": true,
        "label": "Job",
        "multi": false,
        "name": "job",
        "options": [],
        "query": "label_values(job)",
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".+",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values(level)",
        "hide": 0,
        "includeAll": true,
        "label": "로그 레벨",
        "multi": true,
        "name": "level",
        "options": [],
        "query": "label_values(level)",
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "selected": false, "text": "", "value": "" },
        "hide": 0,
        "label": "로그 검색",
        "name": "search",
        "options": [{ "selected": true, "text": "", "value": "" }],
        "query": "",
        "skipUrlSync": false,
        "type": "textbox"
      }
    ]
  },

  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "Asia/Seoul",
  "title": "Small Town — All Log Monitor",
  "uid": "small-town-all-logs",
  "version": 1,

  "panels": [

    {
      "id": 1,
      "type": "stat",
      "title": "전체 로그 건수",
      "description": "선택된 기간 내 전체 로그 합계 (모든 레벨)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "text": {},
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#5794F2" },
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "pluginVersion": "8.3.3",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=~\"$job\", instance=~\"$instance\"}[$__range]))",
          "hide": false,
          "instant": true,
          "range": false,
          "legendFormat": "총 로그",
          "refId": "A"
        }
      ]
    },

    {
      "id": 2,
      "type": "stat",
      "title": "ERROR 건수",
      "description": "선택된 기간 내 ERROR 레벨 로그 합계",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "text": {},
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red",    "value": 50 }
            ]
          },
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "pluginVersion": "8.3.3",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({level=\"error\", job=~\"$job\", instance=~\"$instance\"}[$__range]))",
          "hide": false,
          "instant": true,
          "range": false,
          "legendFormat": "ERROR",
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "type": "stat",
      "title": "WARN 건수",
      "description": "선택된 기간 내 WARN 레벨 로그 합계",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "text": {},
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "orange", "value": 100 }
            ]
          },
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "pluginVersion": "8.3.3",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({level=\"warn\", job=~\"$job\", instance=~\"$instance\"}[$__range]))",
          "hide": false,
          "instant": true,
          "range": false,
          "legendFormat": "WARN",
          "refId": "A"
        }
      ]
    },

    {
      "id": 4,
      "type": "stat",
      "title": "INFO 건수",
      "description": "선택된 기간 내 INFO 레벨 로그 합계",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "text": {},
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#73BF69" },
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "pluginVersion": "8.3.3",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({level=\"info\", job=~\"$job\", instance=~\"$instance\"}[$__range]))",
          "hide": false,
          "instant": true,
          "range": false,
          "legendFormat": "INFO",
          "refId": "A"
        }
      ]
    },

    {
      "id": 5,
      "type": "timeseries",
      "title": "레벨별 로그 발생 추이 (5분 단위)",
      "description": "전체 레벨 로그 건수를 5분 단위로 집계. rate() × 300 = 5분 누적 건수. Job/Instance 필터 적용, 레벨별 색상 구분.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "legend": {
          "calcs": ["sum", "max", "mean"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "로그 건수 / 5분",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 60,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" },
            "thresholdsStyle": { "mode": "off" }
          },
          "unit": "short",
          "min": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 80 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "warn" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "info" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#73BF69" } }]
          },
          {
            "matcher": { "id": "byName", "options": "debug" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#8AB8FF" } }]
          },
          {
            "matcher": { "id": "byName", "options": "trace" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#C4A0FF" } }]
          }
        ]
      },
      "pluginVersion": "8.3.3",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (level) (rate({job=~\"$job\", instance=~\"$instance\"}[5m])) * 300",
          "hide": false,
          "instant": false,
          "range": true,
          "legendFormat": "{{level}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 6,
      "type": "logs",
      "title": "앱 로그 스트림 (small-town)",
      "description": "small-town 애플리케이션 전체 로그 스트림. 상단 '로그 레벨' 필터 적용됨. 최신 순 정렬.",
      "gridPos": { "h": 12, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "pluginVersion": "8.3.3",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"small-town\", instance=~\"$instance\", level=~\"$level\"}",
          "hide": false,
          "instant": false,
          "range": true,
          "legendFormat": "",
          "refId": "A",
          "maxLines": 500
        }
      ]
    },

    {
      "id": 7,
      "type": "logs",
      "title": "크롤러 로그 스트림 (crawler)",
      "description": "크롤러 전체 로그 스트림. 상단 '로그 레벨' 필터 적용됨. 최신 순 정렬.",
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "pluginVersion": "8.3.3",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"crawler\", instance=~\"$instance\", level=~\"$level\"}",
          "hide": false,
          "instant": false,
          "range": true,
          "legendFormat": "",
          "refId": "A",
          "maxLines": 500
        }
      ]
    },

    {
      "id": 8,
      "type": "bargauge",
      "title": "다발 로거 Top 10 (전체 레벨)",
      "description": "로그를 가장 많이 생성한 클래스 Top 10. 선택된 레벨·기간 기준.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "text": {}
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red",    "value": 1000 }
            ]
          },
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "pluginVersion": "8.3.3",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "topk(10, sum by (logger) (count_over_time({job=~\"$job\", instance=~\"$instance\", level=~\"$level\"} | regexp `\\] \\[(?P<thread>[^\\]]+)\\] (?P<logger>\\S+)\\s+:` [$__range])))",
          "hide": false,
          "instant": true,
          "range": false,
          "legendFormat": "{{logger}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 9,
      "type": "bargauge",
      "title": "Job / 레벨별 로그 분포",
      "description": "각 job의 레벨별 로그 건수 비교 (선택된 기간 기준)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "text": {}
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 500 }
            ]
          },
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "pluginVersion": "8.3.3",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (job, level) (count_over_time({job=~\"$job\", instance=~\"$instance\"}[$__range]))",
          "hide": false,
          "instant": true,
          "range": false,
          "legendFormat": "{{job}} / {{level}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 10,
      "type": "logs",
      "title": "로그 검색 결과",
      "description": "상단 '로그 검색'에 키워드 입력 시 해당 텍스트가 포함된 로그만 표시. 비워두면 전체 로그 표시. '로그 레벨' 필터도 동시에 적용됩니다. (대소문자 구분 없음)",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 33 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "pluginVersion": "8.3.3",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=~\"$job\", instance=~\"$instance\", level=~\"$level\"} |~ \"(?i)$search\"",
          "hide": false,
          "instant": false,
          "range": true,
          "legendFormat": "",
          "refId": "A",
          "maxLines": 1000
        }
      ]
    }

  ]
}
