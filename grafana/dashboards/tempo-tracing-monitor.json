  "title": "Small Town — Tracing (Tempo)",
  "uid": "small-town-tempo-tracing",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "최근 트레이스 (전체)",
      "description": "선택된 기간 내 서비스($service)의 전체 트레이스. 클릭하면 워터폴(span 구간별 소요시간) 상세 확인 가능.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"$service\" && trace:rootName!~\".*actuator.*\"}",
          "limit": 50,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "느린 트레이스 ($slow_threshold 초과)",
      "description": "duration이 임계값을 넘는 트레이스만 필터링. 상단 변수로 임계값 조정.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"$service\" && duration>$slow_threshold}",
          "limit": 50,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "에러 트레이스",
      "description": "status=error span이 포함된 트레이스. 예외 발생 구간 즉시 확인용.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"$service\" && status=error}",
          "limit": 50,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "AI 요약 (ai-summary-stream)",
      "description": "AiSummaryService.streamAiSummary — Gemini SSE 스트리밍 구간 (@Observed name=ai-summary)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{name=\"ai-summary-stream\"}",
          "limit": 30,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "벡터 검색 (search.vector)",
      "description": "VectorSearchService — Clova 임베딩 기반 halfvec 검색 구간 (필터/비필터 모두 포함) ※ 이 패널은 span 이름으로만 거른 것이라 검색 API·프리워밍 스케줄러·RAG 채팅이 섞인다. 검색 API 요청 1건 기준으로 묶어 보려면 상단 '검색 API 트레이스' 대시보드를 쓸 것.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{name=~\"vector-search.*\"}",
          "limit": 30,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "BM25 검색 (search.bm25)",
      "description": "ArticleSearchService — article_analyzed_content 기반 BM25 검색 구간 (private 메서드, 수동 Observation) ※ 이 패널은 span 이름으로만 거른 것이라 검색 API·프리워밍 스케줄러·RAG 채팅이 섞인다. 검색 API 요청 1건 기준으로 묶어 보려면 상단 '검색 API 트레이스' 대시보드를 쓸 것.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{name=\"bm25-search\"}",
          "limit": 30,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "NSF 융합 (search.nsf)",
      "description": "HybridSearchScorer.calculateNSFScores — BM25/Vector 정규화 가중합 구간 ※ 이 패널은 span 이름으로만 거른 것이라 검색 API·프리워밍 스케줄러·RAG 채팅이 섞인다. 검색 API 요청 1건 기준으로 묶어 보려면 상단 '검색 API 트레이스' 대시보드를 쓸 것.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{name=~\"nsf-fusion.*\"}",
          "limit": 30,
